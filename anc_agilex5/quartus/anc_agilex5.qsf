# Quartus Prime Pro project for Agilex 5 E-Series 065B Modular Dev Kit
# Device: A5ED065BB32AE4S (adjust OPN for your board revision)

set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5ED065BB32AE4S
set_global_assignment -name TOP_LEVEL_ENTITY anc_board
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name SEARCH_PATH ../rtl

# RTL
set_global_assignment -name VERILOG_FILE ../rtl/anc_pkg.vh
set_global_assignment -name VERILOG_FILE ../rtl/audio_clock_gen.v
set_global_assignment -name VERILOG_FILE ../rtl/i2s_rx.v
set_global_assignment -name VERILOG_FILE ../rtl/i2s_tx.v
set_global_assignment -name VERILOG_FILE ../rtl/audio_sync_fifo.v
set_global_assignment -name VERILOG_FILE ../rtl/fir_mac_engine.v
set_global_assignment -name VERILOG_FILE ../rtl/secondary_path_fir.v
set_global_assignment -name VERILOG_FILE ../rtl/fxlms_engine.v
set_global_assignment -name VERILOG_FILE ../rtl/spectral_features.v
set_global_assignment -name VERILOG_FILE ../rtl/ai_noise_classifier.v
set_global_assignment -name VERILOG_FILE ../rtl/notch_iir.v
set_global_assignment -name VERILOG_FILE ../rtl/i2c_master.v
set_global_assignment -name VERILOG_FILE ../rtl/codec_init.v
set_global_assignment -name VERILOG_FILE ../rtl/anc_control_regs.v
set_global_assignment -name VERILOG_FILE ../rtl/anc_top.v
set_global_assignment -name VERILOG_FILE ../rtl/anc_board.v

set_global_assignment -name SDC_FILE anc_agilex5.sdc

# Board-level pins (placeholders — confirm against 065B User Guide PO-3274)
set_location_assignment PIN_AJ27 -to sys_clk
set_instance_assignment -name IO_STANDARD "1.2-V" -to sys_clk

set_location_assignment PIN_AA30 -to mclk
set_location_assignment PIN_AB30 -to bclk
set_location_assignment PIN_AC30 -to lrck
set_location_assignment PIN_AD30 -to i2s_adc_data
set_location_assignment PIN_AE30 -to i2s_dac_data
set_location_assignment PIN_AF30 -to i2c_scl
set_location_assignment PIN_AG30 -to i2c_sda

set_instance_assignment -name IO_STANDARD "1.2-V" -to mclk
set_instance_assignment -name IO_STANDARD "1.2-V" -to bclk
set_instance_assignment -name IO_STANDARD "1.2-V" -to lrck
set_instance_assignment -name IO_STANDARD "1.2-V" -to i2s_adc_data
set_instance_assignment -name IO_STANDARD "1.2-V" -to i2s_dac_data
set_instance_assignment -name IO_STANDARD "1.2-V" -to i2c_scl
set_instance_assignment -name IO_STANDARD "1.2-V" -to i2c_sda
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to i2c_scl
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to i2c_sda

set_location_assignment PIN_AJ28 -to anc_active_led
set_location_assignment PIN_AK28 -to clip_led
set_location_assignment PIN_AL28 -to codec_ready_led
set_instance_assignment -name IO_STANDARD "1.2-V" -to anc_active_led
set_instance_assignment -name IO_STANDARD "1.2-V" -to clip_led
set_instance_assignment -name IO_STANDARD "1.2-V" -to codec_ready_led

# AXI ports are connected inside Platform Designer — do not assign pins.
# reset_n comes from HPS / reset bridge.
