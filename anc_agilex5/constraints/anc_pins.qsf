# Pin template (legacy). Authoritative assignments live in
# anc_agilex5/quartus/anc_agilex5.qsf — copy from there.

# System clock (100 MHz on-board oscillator)
set_location_assignment PIN_AJ27 -to sys_clk
set_instance_assignment -name IO_STANDARD "1.2 V" -to sys_clk

# I2S to Pmod I2S2 (HVIO header — adjust pin numbers for your carrier)
set_location_assignment PIN_AA30 -to mclk
set_location_assignment PIN_AB30 -to bclk
set_location_assignment PIN_AC30 -to lrck
set_location_assignment PIN_AD30 -to i2s_adc_data
set_location_assignment PIN_AE30 -to i2s_dac_data
set_instance_assignment -name IO_STANDARD "1.2 V" -to mclk
set_instance_assignment -name IO_STANDARD "1.2 V" -to bclk
set_instance_assignment -name IO_STANDARD "1.2 V" -to lrck
set_instance_assignment -name IO_STANDARD "1.2 V" -to i2s_adc_data
set_instance_assignment -name IO_STANDARD "1.2 V" -to i2s_dac_data

# Status LEDs
set_location_assignment PIN_AJ28 -to anc_active_led
set_location_assignment PIN_AK28 -to clip_led
set_instance_assignment -name IO_STANDARD "1.2 V" -to anc_active_led
set_instance_assignment -name IO_STANDARD "1.2 V" -to clip_led

# Timing constraints (add to .sdc)
# create_clock -name sys_clk -period 10.000 [get_ports sys_clk]
# set_clock_groups -asynchronous -group [get_clocks sys_clk] -group [get_clocks bclk]
# set_false_path -from [get_ports i2s_adc_data]

# NOTE: Pin assignments above are PLACEHOLDERS. Consult the Agilex 5 E-Series
# 065B Modular Development Kit User Guide (PO-3274) for actual HVIO pin numbers
# on your specific carrier revision.
